# PUBLIC INTERFACE: Environment configuration for notes_frontend
# Copy this file to .env and set the values.
# The app uses these to call the backend REST APIs and construct email redirects.

# Base URL for the backend REST API (notes_database container reverse-proxied URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Site URL used for auth email redirects (if backend requires email link flows)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
